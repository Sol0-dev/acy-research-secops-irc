PORT=8787
# API stays on loopback; only the web proxy may reach it.
API_HOST=127.0.0.1
# Public web listener (agents use the UI only).
WEB_HOST=0.0.0.0
WEB_PORT=5180
VITE_API_TARGET=http://127.0.0.1:8787
# Shared secret injected by the Vite proxy. Change in production.
API_PROXY_TOKEN=replace-with-a-long-random-proxy-token
# Token for the hidden read-only admin panel. If empty, one is generated at
# startup and printed to the API log.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Hidden admin username/password. If the password is empty, one is generated
# and printed to the API log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acy
DB_PASSWORD=acy_dev_password
DB_NAME=secops_irc
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5180
